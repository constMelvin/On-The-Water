# ==========================================
# OTW SERVER - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Server port
SERVER_PORT=8080

# ------------------------------------------
# Java (Windows only — if mvnw uses wrong JDK)
# ------------------------------------------
# Set this if `mvnw.cmd compile` fails with "release version 21 not supported"
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.101-hotspot

# ------------------------------------------
# Supabase PostgreSQL Database (Flyway + JPA)
# ------------------------------------------
# Direct connection (port 5432) or Session pooler (port 5432).
# DO NOT use Transaction pooler (port 6543) for Flyway migrations.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# ------------------------------------------
# Supabase API & Auth
# ------------------------------------------
# Your Supabase project URL (Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anonymous key (used on client, optional on backend)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend service role key (Settings -> API -> service_role secret)
# Used for backend administrative operations and Realtime Broadcast publishing
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Expected JWT Audience (usually "authenticated" for Supabase)
SUPABASE_JWT_AUD=authenticated

# Supabase Auth JWKS endpoint for validating user JWTs
# Defaults to: https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Expected JWT Issuer
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# ------------------------------------------
# Redis Configuration (Optional for initial local dev)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
