# ==========================================
# OTW SERVER - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control!

# Server port
SERVER_PORT=8080

# ------------------------------------------
# Java (Windows only — if mvnw uses wrong JDK)
# ------------------------------------------
# Set this if `mvnw.cmd compile` fails with "release version 21 not supported"
# JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-21.0.12.101-hotspot

# ------------------------------------------
# Supabase PostgreSQL Database (Flyway + JPA)
# ------------------------------------------
# Direct connection (port 5432) or Session pooler (port 5432).
# DO NOT use Transaction pooler (port 6543) for Flyway migrations.
SPRING_DATASOURCE_URL=jdbc:postgresql://db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD

# ------------------------------------------
# Supabase API & Auth
# ------------------------------------------
# Your Supabase project URL (Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Public anonymous key (used on client, optional on backend)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend service role key (Settings -> API -> service_role secret)
# Used for backend administrative operations and Realtime Broadcast publishing
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Expected JWT Audience (usually "authenticated" for Supabase)
SUPABASE_JWT_AUD=authenticated

# Supabase Auth JWKS endpoint for validating user JWTs
# Defaults to: https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Expected JWT Issuer
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1

# ------------------------------------------
# Redis Configuration (Optional for initial local dev)
# ------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ------------------------------------------
# Google Drive (Gala Dump photos/videos) — full guide: docs/GOOGLE_DRIVE_SETUP.md
# ------------------------------------------
# The backend never uploads/downloads photo binaries. It makes one folder per
# gala inside the folder below, hands the browser a one-time upload link, then
# checks the uploaded file (real image/video, not trashed, inside that gala's
# folder) before saving its metadata. Leaving these blank makes uploads and
# photo registration fail closed (reject) rather than skip the check.
#
# 1. Google Cloud Console -> enable the "Google Drive API" for the project
#    (APIs & Services -> Enable APIs and Services -> search "Google Drive API").
#    Then IAM & Admin -> Service Accounts -> create one -> Keys -> Add Key ->
#    JSON. This downloads a credentials.json file.
# 2. Base64-encode the whole file into ONE line (avoids all the quoting/
#    newline issues of pasting raw JSON into a .env file):
#      PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("credentials.json"))
#      macOS/Linux: base64 -i credentials.json | tr -d '\n'
#    Paste that single line as the value below.
GOOGLE_DRIVE_CREDENTIALS_JSON_BASE64=

# 3. Create (or pick) a Drive folder for room photos, share it with the
#    service account's email (the "client_email" field inside
#    credentials.json) as Editor (Content manager in a Shared Drive: the
#    backend creates gala folders and trashes files), and put that folder's
#    ID here (the part after /folders/ in the folder's Drive URL).
GOOGLE_DRIVE_PHOTOS_FOLDER_ID=YOUR_DRIVE_FOLDER_ID

# Optional, cosmetic only — shown in Google Cloud API usage/quota dashboards.
GOOGLE_DRIVE_APPLICATION_NAME=OTW

# Upload as YOUR Google account (normal Gmail Drive: service accounts have no storage of their
# own, so they can't own uploaded files outside a Shared Drive). When these three are set they
# win over GOOGLE_DRIVE_CREDENTIALS_JSON_BASE64, and nobody else ever signs in to Google.
# Get the refresh token once from https://developers.google.com/oauthplayground with your own
# OAuth client (scope https://www.googleapis.com/auth/drive). Keep the OAuth app "In production"
# or the token expires after 7 days.
GOOGLE_DRIVE_OAUTH_CLIENT_ID=
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional: how often to trash Drive files in gala folders that have no photo row
# (uploads never registered, failed deletes), and how old they must be first.
# Cron "-" turns the sweep off. Defaults shown (every 6 hours, files older than 24 h).
# GOOGLE_DRIVE_ORPHAN_SWEEP_CRON="0 30 */6 * * *"
# GOOGLE_DRIVE_ORPHAN_SWEEP_MIN_AGE=PT24H

# ------------------------------------------
# CORS Configuration
# ------------------------------------------
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
