# ==========================================
# OTW CLIENT - Environment Configuration
# ==========================================
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real values.
#
# Next.js only exposes vars prefixed NEXT_PUBLIC_ to the browser. Everything
# in this file ends up in the client bundle — never put a secret here.

# ------------------------------------------
# Backend API
# ------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080

# ------------------------------------------
# Supabase (public values only)
# ------------------------------------------
# Same SUPABASE_URL and SUPABASE_ANON_KEY already set in otw-server/.env.
# The anon key is safe for the browser by design (Supabase's RLS policies
# are what actually protect data, not keeping this key secret).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ------------------------------------------
# DO NOT add SUPABASE_SERVICE_ROLE_KEY here or anywhere in this project.
# It bypasses Row Level Security entirely and must never reach the browser.
# It belongs only in otw-server/.env (backend), never prefixed NEXT_PUBLIC_,
# and never used from client-side code.
# ------------------------------------------

# ------------------------------------------
# Google OAuth (only needed for the /testing page's "Connect Google Drive" /
# direct-upload feature — NOT the same credential as the backend's service
# account, which only reads metadata and can't upload).
# ------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials
# -> OAuth client ID -> Application type: Web application -> Authorized
# JavaScript origins: http://localhost:3000
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com

# Same Drive folder ID as otw-server/.env's GOOGLE_DRIVE_PHOTOS_FOLDER_ID —
# files uploaded via the test page land here so the backend's validator
# (which checks against that same folder) will accept them.
NEXT_PUBLIC_GOOGLE_DRIVE_PHOTOS_FOLDER_ID=YOUR_DRIVE_FOLDER_ID

# ------------------------------------------
# Public contact email shown on /privacy (account deletion requests). Optional.
# ------------------------------------------
NEXT_PUBLIC_CONTACT_EMAIL=
